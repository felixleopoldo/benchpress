{
    "title": "average_adjmat",
    "description": "Computes average adjacency matrix over seeds to show edge recovery probability.",
    "type": "object",
    "properties": {
        "ids": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "List of algorithm IDs to include."
        },
        "annot": {
            "type": "boolean",
            "default": false,
            "description": "If true, write the value as text in each cell of the heatmap."
        },
        "show_cbar": {
            "type": "boolean",
            "default": true,
            "description": "If true, show the colorbar to the right of the heatmap."
        },
        "graph_type": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": ["original", "cpdag", "skeleton", "pattern"]
                },
                {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": ["original", "cpdag", "skeleton", "pattern"]
                    },
                    "minItems": 1
                }
            ],
            "default": "original",
            "description": "Graph type(s) to convert estimates to before averaging. Can be a single string or a list."
        }
    },
    "required": ["ids"],
    "additionalProperties": false,
    "examples": {
        "average_adjmat": {
            "ids": ["fges-sem-bic", "pc-gaussCItest"],
            "graph_type": "skeleton"
        }
    }
}
